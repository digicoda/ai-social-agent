APP_ENV=development
DATABASE_URL=sqlite:///./data/ai_social_agent.db
INTERNAL_API_KEY=

# AI provider
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Research sources
REDDIT_USER_AGENT=ai-social-agent/0.1
RSS_FEEDS=https://hnrss.org/frontpage

# Publishing - keep credentials only in environment/secrets
LINKEDIN_ACCESS_TOKEN=
# Person URN: urn:li:person:<id> or organization URN
LINKEDIN_AUTHOR_URN=
LINKEDIN_API_VERSION=202603
PUBLISHING_TIMEOUT_SECONDS=20

# Scheduling / retries
RETRY_BASE_SECONDS=60
RETRY_MAX_SECONDS=3600
WORKER_BATCH_SIZE=10
